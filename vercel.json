{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/signin-with-chatgpt",
      "destination": "/signin.html",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "/studio.html",
      "permanent": false
    },
    {
      "source": "/agreement.html",
      "destination": "/application.html",
      "permanent": false
    },
    {
      "source": "/journey.html",
      "destination": "/application.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self' https: blob:; frame-src 'self'; connect-src 'self' https://hlmlqdkcwchmzxbcvrtp.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
